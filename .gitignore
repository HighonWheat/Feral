# Ignore generated numpy vectors, datasets, and checkpoints
*.npy
*.jsonl
*.parquet
outputs/
checkpoints/
lora_model/
feral_sandbox/

# Ignore Python & Windows artifacts
__pycache__/
*.py[cod]
.env
.venv/
